<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContentMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    tools:ignore="UseCompoundDrawables,UselessParent">

                    <ImageView
                        android:id="@+id/icLocation"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_location"
                        android:contentDescription="@string/location" />

                    <TextView
                        android:id="@+id/txtAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Freedom way, Lekki phase"
                        android:textSize="12sp"
                        android:textColor="#4B5563" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/bg_search"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/icSearch"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search" />

                <EditText
                    android:id="@+id/txtSearchHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:autofillHints="Burger"
                    android:hint="@string/search"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:textSize="12sp"
                    android:textColor="@color/black" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardBanner"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="10dp"
                app:cardUseCompatPadding="false"
                app:cardElevation="2dp">

                <ImageView
                    android:id="@+id/imgBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_banner_burger"
                    android:contentDescription="@string/banner" />

                <!-- Overlay nội dung -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_gravity="top|start">

                    <TextView
                        android:id="@+id/txtOfferTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Special Offer\nfor March"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOfferSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="We are here with the best\ndeserts in town."
                        android:textColor="@android:color/white"
                        android:textSize="10sp"
                        tools:ignore="SmallSp" />

                    <TextView
                        android:id="@+id/btnBuyNow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/buy_now"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_secondary"
                        android:textColor="@color/primary"
                        tools:ignore="SmallSp" />
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Chip category (Burger / Pizza / Sandwich) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Selected: Burger -->
                    <LinearLayout
                        android:id="@+id/chipBurger"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_button_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="20dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍔"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Burger"
                            android:textSize="18sp"
                            android:textColor="@android:color/white" />
                    </LinearLayout>

                    <!-- Pizza -->
                    <LinearLayout
                        android:id="@+id/chipPizza"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_button_outline_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="20dp"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍕"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Pizza"
                            android:textSize="18sp"
                            android:textColor="#0D0D0D" />
                    </LinearLayout>

                    <!-- Sandwich -->
                    <LinearLayout
                        android:id="@+id/chipSandwich"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_button_outline_primary"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌭"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Sandwich"
                            android:textSize="18sp"
                            android:textColor="#0D0D0D" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="210dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="0dp"/>
                    <!-- Card 1 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="200dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <!-- Ảnh burger -->
                            <ImageButton
                                android:id="@+id/imgBurger1"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_marginTop="8dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/img_burger1"
                                android:background="@android:color/transparent"
                                android:contentDescription="@string/burger_image" />

                            <!-- Tên + mô tả -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Chicken burger"
                                android:textSize="15sp"
                                android:textColor="#0D0D0D"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="100 gr chicken + tomato + cheese Lettuce"
                                android:textSize="11sp"
                                android:textColor="#803B3B3B"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="2dp" />

                            <!-- Giá + nút thêm -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:weightSum="1"
                                tools:ignore="UseCompoundDrawables">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="$ 20.00"
                                    android:textSize="14sp"
                                    android:textColor="#D61355"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/btnAdd1"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_add"
                                    android:background="@drawable/bg_add_round"
                                    android:padding="4dp"
                                    android:contentDescription="@string/add_to_cart" />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Card 2 (ví dụ) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="200dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:id="@+id/imgBurger2"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_marginTop="8dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/img_burger2"
                                android:contentDescription="@string/burger_image" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Cheese burger"
                                android:textSize="15sp"
                                android:textColor="#0D0D0D"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="100 gr meat + onion + tomato + Lettuce cheese"
                                android:textSize="11sp"
                                android:textColor="#803B3B3B"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="2dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:weightSum="1"
                                tools:ignore="UseCompoundDrawables">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="$ 15.00"
                                    android:textSize="14sp"
                                    android:textColor="#D61355"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_add"
                                    android:background="@drawable/bg_add_round"
                                    android:padding="4dp"
                                    android:contentDescription="@string/add_to_cart" />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="160dp"
                        android:layout_height="200dp"
                        android:layout_marginEnd="16dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_marginTop="8dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/img_burger2"
                                android:contentDescription="@string/burger_image" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Cheese burger"
                                android:textSize="15sp"
                                android:textColor="#0D0D0D"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="100 gr meat + onion + tomato + Lettuce cheese"
                                android:textSize="10sp"
                                android:textColor="#803B3B3B"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:layout_marginTop="2dp"
                                tools:ignore="SmallSp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:weightSum="1"
                                tools:ignore="UseCompoundDrawables">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="$ 15.00"
                                    android:textSize="14sp"
                                    android:textColor="#D61355"
                                    android:textStyle="bold" />

                                <ImageView
                                    android:id="@+id/btnAdd2"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_add"
                                    android:background="@drawable/bg_add_round"
                                    android:padding="4dp"
                                    android:contentDescription="@string/add_to_cart" />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Popular Meal Menu header -->
            <LinearLayout
                android:id="@+id/headerPopular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Popular Meal Menu"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See All"
                        android:textSize="12sp"
                        android:textColor="#803B3B3B" />
                </LinearLayout>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardPepperPizza"
                android:layout_width="match_parent"
                android:layout_height="87dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="7dp"
                app:cardElevation="2dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgPepperPizza"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/img_pepper_pizza"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_button_secondary"
                        android:contentDescription="@string/pizza" />

                    <TextView
                        android:id="@+id/txtPizzaName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/imgPepperPizza"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:text="Pepper Pizza"
                        android:textColor="#000000"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtPizzaDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/imgPepperPizza"
                        android:layout_below="@id/txtPizzaName"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp"
                        android:text="5kg box of Pizza"
                        android:textSize="14sp"
                        android:textColor="#803B3B3B" />

                    <TextView
                        android:id="@+id/txtPizzaPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="$15"
                        android:textSize="22sp"
                        android:textColor="#D61355"
                        android:textStyle="bold" />

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Home -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:layout_marginEnd="50dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_button_secondary"
                android:paddingVertical="5dp"
                tools:ignore="UseCompoundDrawables">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home_filled"
                    android:contentDescription="@string/home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home"
                    android:textSize="12sp"
                    android:layout_marginStart="5dp"
                    android:textColor="#000000" />
            </LinearLayout>

            <!-- Cart -->
            <LinearLayout
                android:id="@+id/navCart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/btnCart"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_cart"
                    android:contentDescription="@string/cart" />
            </LinearLayout>

            <!-- Profile -->
            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/primary"
                    android:contentDescription="@string/profile" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
